# ==========================================
# NEXUSDESK ENVIRONMENT CONFIGURATION (.env.example)
# Bitget AI Base Camp Hackathon Season 2
# ==========================================

# --- Qwen LLM Credentials (Alibaba Cloud via Bitget Gateway) ---
QWEN_API_KEY="your_qwen_api_key_here"
QWEN_BASE_URL="https://hackathon.bitgetops.com/v1"
QWEN_MODEL="qwen3.8-max"

# --- Server Configuration ---
PORT=3000
NODE_ENV=development

# --- Bitget API Credentials (UTA v3 Paper Trading / Demo) ---
BITGET_API_KEY=""
BITGET_SECRET_KEY=""
BITGET_PASSPHRASE=""
BITGET_IS_PAPER_TRADING=true
BITGET_API_URL="https://api.bitget.com"

# --- Supabase Credentials (Session Memory & Trade History) ---
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key"
